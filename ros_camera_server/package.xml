<?xml version='1.0' encoding='UTF-8'?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros_camera_server</name>
  <version>0.1.0</version>
  <description>ROS 2 camera streaming hub that ingests video from multiple sources, transcodes it via GStreamer, and distributes it to multiple outputs with low latency.</description>
  <maintainer email="fabian@sim.tu-darmstadt.de">Stefan Fabian</maintainer>
  <license>AGPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>libgstreamer-plugins-bad1.0-dev</build_depend>
  <build_depend>libgstreamer-plugins-base1.0-dev</build_depend>
  <build_depend>libgstreamer1.0-dev</build_depend>
  <build_depend>libsoup-3.0-dev</build_depend>
  <build_depend>yaml-cpp</build_depend>
  <build_export_depend>libgstreamer-plugins-base1.0-dev</build_export_depend>
  <build_export_depend>libgstreamer1.0-dev</build_export_depend>
  <build_export_depend>libsoup-3.0-dev</build_export_depend>

  <depend>gstreamer_ros_babel_fish</depend>
  <depend>rclcpp</depend>
  <depend>ros_camera_server_msgs</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>gstreamer1.0</exec_depend>
  <exec_depend>gstreamer1.0-nice</exec_depend>
  <exec_depend>gstreamer1.0-plugins-bad</exec_depend>
  <exec_depend>gstreamer1.0-plugins-base</exec_depend>
  <exec_depend>gstreamer1.0-plugins-good</exec_depend>
  <exec_depend>gstreamer1.0-plugins-ugly</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
